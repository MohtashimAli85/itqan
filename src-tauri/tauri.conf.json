{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Itqan",
  "version": "0.1.0",
  "identifier": "dev.itqan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Itqan",
        "url": "index.html",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Itqan Overlay",
        "url": "overlay.html",
        "width": 320,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
